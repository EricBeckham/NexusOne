      <artifactId>isolation-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-data-core</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-permission-core</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-expression-core</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-event-core</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-task-core</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-cache-core</artifactId>
    </dependency>
    <dependency>
