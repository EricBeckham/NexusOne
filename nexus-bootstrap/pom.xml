      <artifactId>nexus-audit-core</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-crypto-core</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-p1-tenant</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-p2-iam</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-p3-studio</artifactId>
    </dependency>
    <dependency>
      <groupId>one.nexus</groupId>
      <artifactId>nexus-p4-market</artifactId>
    </dependency>
    <dependency>
