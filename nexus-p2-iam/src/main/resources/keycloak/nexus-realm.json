{
  "realm": "nexus",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "NexusOne M0-04",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "nexus-platform",
      "name": "NexusOne confidential platform client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "replace-at-import",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://127.0.0.1:18088/api/v1/auth/callback",
        "http://127.0.0.1:8088/api/v1/auth/callback",
        "http://127.0.0.1:8080/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:18088",
        "http://127.0.0.1:8088",
        "http://127.0.0.1:8080"
      ],
      "defaultClientScopes": ["basic", "profile", "email", "roles", "web-origins", "acr"],
      "optionalClientScopes": ["offline_access", "phone"],
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
