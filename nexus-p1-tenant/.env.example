# Copy to a local untracked file. Do not commit real secrets.
#   cp .env.example .env.local
#   set -a && source .env.local && set +a

NEXUS_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/nexus_p1
NEXUS_DATASOURCE_USERNAME=nexus_p1
NEXUS_DATASOURCE_PASSWORD=

# Optional test database (mvn test uses this URL unless overridden)
NEXUS_TEST_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/nexus_p1_test

NEXUS_P1_PORT=18081

# Demo-only. Production entry (M0-01/M0-02) must keep this false and strip identity headers.
NEXUS_P1_DEMO_CONTEXT_ENABLED=false

# Provisional M0 defaults. Not frozen product maxima (P0-08 left capacity unfrozen).
NEXUS_P1_QUOTA_APP_LIMIT=5
NEXUS_P1_QUOTA_CUSTOM_LEDGER_LIMIT=10
NEXUS_P1_QUOTA_WARN_PERCENT=80
