{
  "name": "nexusone-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NexusOne Vue 3 shell: desktop M0-12 plus G15 H5 mobile login-redirect / files / routing / host-message / F010 runtime / simulated 小程序 web-view / APP WebView web-harness / WeChat-DingTalk production-host stub / native-bridge stub leftover.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:g7-withdraw": "vitest run src/views/studio/todo-withdraw.browser.test.js src/api/p3-withdraw-http-reachability.test.js",
    "assert:g7-withdraw-browser": "node scripts/assert-g7-withdraw-browser.mjs",
    "test:g4-pkce": "vitest run src/views/login-pkce.browser.test.js",
    "test:g17-totp-enroll": "vitest run src/auth/totp.test.js src/auth/totpEnrollment.test.js src/views/login-mfa.browser.test.js src/views/org/totp-enroll.browser.test.js",
    "assert:g17-totp-enroll": "node scripts/assert-g17-totp-enrollment-ux.mjs",
    "test:g17-mfa-recovery-email": "vitest run src/auth/recoveryCodes.test.js src/auth/emailMfa.test.js src/auth/totpEnrollment.test.js src/views/org/recovery-codes.browser.test.js src/views/org/email-mfa.browser.test.js src/views/org/totp-enroll.browser.test.js src/views/login-mfa.browser.test.js",
    "assert:g17-mfa-recovery-email": "node scripts/assert-g17-mfa-recovery-email.mjs",
    "test:g17-vue-otp-writeback": "vitest run src/auth/totpWriteback.test.js src/views/org/totp-enroll.browser.test.js",
    "assert:g17-vue-otp-writeback": "node scripts/assert-g17-vue-otp-writeback.mjs",
    "assert:isolation": "node scripts/assert-client-isolation.mjs",
    "assert:p3-live": "node scripts/assert-p3-live.mjs",
    "assert:h5": "node scripts/assert-h5-mobile.mjs",
    "assert:h5-host": "node scripts/assert-h5-host.mjs",
    "assert:h5-mp-webview": "node scripts/assert-h5-mp-webview.mjs",
    "assert:h5-runtime": "node scripts/assert-h5-runtime.mjs",
    "assert:h5-permission": "node scripts/assert-h5-permission.mjs",
    "assert:h5-app-webview": "node scripts/assert-h5-app-webview.mjs",
    "assert:h5-wx-dt": "node scripts/assert-h5-wx-dt.mjs",
    "assert:h5-native-bridge": "node scripts/assert-h5-native-bridge.mjs",
    "assert:h5-pkce": "node scripts/assert-h5-pkce.mjs",
    "assert:g4-spa-verifier": "node scripts/assert-g4-spa-verifier.mjs",
    "assert:g2-report-surface": "node scripts/assert-g2-report-surface.mjs",
    "assert:g2-physical-dump": "node scripts/assert-g2-physical-dump.mjs",
    "assert:g4-export-wizard": "node scripts/assert-g4-export-wizard.mjs",
    "test:g4-export-wizard": "vitest run src/views/studio/export-wizard.browser.test.js"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
