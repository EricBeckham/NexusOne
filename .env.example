NEXUS_DB_URL=jdbc:postgresql://127.0.0.1:5432/nexusone
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=
NEXUS_HTTP_PORT=8080

# M0-12 local UI / dual-tenant scripts (never commit real secrets)
NEXUS_P1_DEMO_CONTEXT_ENABLED=true
NEXUS_P3_DEMO_CONTEXT_ENABLED=false
NEXUS_PLATFORM_BOOTSTRAP_TOKEN=
NEXUS_IAM_IDP=stub
NEXUS_IAM_PERSISTENCE=memory
NEXUS_WEB_PORT=5173
# P3 ledger/form/todo UI always uses live HTTP. MOCK toggle is retired.
# VITE_NEXUS_P3_USE_MOCK=

# M0-05 permission engine (secrets via env only)
NEXUS_PERM_PERSISTENCE=memory
NEXUS_REDIS_ENABLED=false
NEXUS_REDIS_HOST=127.0.0.1
NEXUS_REDIS_PORT=6379

# M0-10 cache / file (local Redis 3.2 + optional MinIO/S3)
# S3 access/secret keys are read by SecretPort from these env vars, not Spring properties.
NEXUS_CACHE_ENV=dev
NEXUS_CACHE_MODE=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_TEST_BUCKET=

# M0-07 form + publish (demo TenantContext headers are test-only)
NEXUS_STUDIO_PERSISTENCE=jdbc
NEXUS_STUDIO_DEMO_CONTEXT=false
NEXUS_STUDIO_SEED_DEMO_METADATA=true
