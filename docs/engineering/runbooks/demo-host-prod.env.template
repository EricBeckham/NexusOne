# NexusOne 演示机 prod 环境变量模板（M6）
#
# 对照清单：docs/engineering/runbooks/demo-host-prod-deployment.md（P6）
# 本文件 = 可填占位符模板，≠ 已部署、≠ 可提交的真实 env。
#
# 用法：
#   1. 复制为本机/密钥管理器侧的私有文件（勿提交仓库）。
#   2. 将所有 REPLACE_* 换成环境所有者提供的值。
#   3. 由服务管理器注入进程环境；不要写进 JAR / 镜像层 / 发布包。
#
# 禁止：真实口令、主密钥、client secret、证书私钥、token。

# --- Spring / 进程 ---
# 启动命令另加：--spring.profiles.active=prod
# 推荐不设置 SPRING_PROFILES_ACTIVE，避免误带 demo。
# SPRING_PROFILES_ACTIVE=

NEXUS_HTTP_PORT=8080

# --- PostgreSQL（必需）---
NEXUS_DB_URL=jdbc:postgresql://REPLACE_DB_HOST:5432/REPLACE_DB_NAME
NEXUS_DB_USER=REPLACE_DB_USER
NEXUS_DB_PASSWORD=REPLACE_FROM_SECRET_STORE

# 仅当 IAM / permission 使用独立库时再填（默认可复用主库）：
# NEXUS_IAM_JDBC_URL=
# NEXUS_IAM_JDBC_USERNAME=
# NEXUS_IAM_JDBC_PASSWORD=
# NEXUS_PERMISSION_JDBC_URL=
# NEXUS_PERMISSION_JDBC_USERNAME=
# NEXUS_PERMISSION_JDBC_PASSWORD=

# --- Crypto（必需；INTERNATIONAL ≥ 32 字节 = 64 hex）---
NEXUS_CRYPTO_KEY_SOURCE=env
NEXUS_CRYPTO_MASTER_KEY=REPLACE_HEX_MASTER_KEY_FROM_SECRET_STORE

# --- Keycloak（必需；演示机禁止 stub）---
NEXUS_IAM_IDP=keycloak
NEXUS_IAM_PERSISTENCE=jdbc
NEXUS_PERMISSION_PERSISTENCE=jdbc
NEXUS_IAM_KEYCLOAK_ISSUER=https://REPLACE_KEYCLOAK_HOST/realms/REPLACE_REALM
NEXUS_IAM_KEYCLOAK_CLIENT_ID=REPLACE_CONFIDENTIAL_CLIENT_ID
NEXUS_IAM_KEYCLOAK_CLIENT_SECRET=REPLACE_FROM_SECRET_STORE
NEXUS_IAM_KEYCLOAK_REDIRECT_URI=https://REPLACE_DEMO_HOST/REPLACE_CALLBACK_PATH

# --- 演示开关：演示机必须关闭 ---
NEXUS_DEMO_ENABLED=false
# NEXUS_DEMO_ENVIRONMENT=   # 可不设；prod profile 固定为 prod
NEXUS_P1_DEMO_CONTEXT_ENABLED=false
NEXUS_P3_DEMO_CONTEXT_ENABLED=false
NEXUS_STUDIO_DEMO_CONTEXT=false
NEXUS_STUDIO_SEED_DEMO_METADATA=false

# --- 引导 token：默认空；短窗口初始化后再清空并重启 ---
NEXUS_PLATFORM_BOOTSTRAP_TOKEN=
NEXUS_FILE_BOOTSTRAP_TOKEN=

# --- Redis（私网；当前产品无 Redis 口令配置）---
NEXUS_REDIS_HOST=REPLACE_REDIS_HOST
NEXUS_REDIS_PORT=6379
NEXUS_CACHE_MODE=REPLACE_auto_or_redis

# --- 对象存储（推荐 S3/MinIO；memory 须接受重启丢失）---
NEXUS_FILE_STORAGE=s3
S3_ENDPOINT=https://REPLACE_S3_ENDPOINT
S3_TEST_BUCKET=REPLACE_BUCKET
S3_ACCESS_KEY=REPLACE_FROM_SECRET_STORE
S3_SECRET_KEY=REPLACE_FROM_SECRET_STORE
