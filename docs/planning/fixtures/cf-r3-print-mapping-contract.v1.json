      { "id": "header.applicant", "label": "申请人", "section": "header", "accepts": ["PERSON", "TEXT"], "repeatable": false },
      { "id": "header.submitted_at", "label": "提交时间", "section": "header", "accepts": ["DATE", "DATETIME"], "repeatable": false },
      { "id": "form.fields", "label": "表单字段区", "section": "form", "accepts": ["*"], "repeatable": true },
      { "id": "approval.opinion", "label": "审批意见", "section": "approval", "accepts": ["TEXTAREA", "TEXT"], "repeatable": false },
      { "id": "approval.approver_sign", "label": "审批人签字", "section": "approval", "accepts": ["PERSON", "TEXT"], "repeatable": false },
      { "id": "approval.approved_at", "label": "审批日期", "section": "approval", "accepts": ["DATE", "DATETIME"], "repeatable": false }
