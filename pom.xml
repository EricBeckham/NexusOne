<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>one.nexus</groupId>
  <artifactId>nexusone</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NexusOne</name>
  <description>NexusOne modular monolith. M0-01 engineering foundation.</description>

  <modules>
    <module>modules/isolation-kernel</module>
    <module>nexus-common</module>
    <module>nexus-data-core</module>
    <module>nexus-permission-core</module>
    <module>nexus-expression-core</module>
    <module>nexus-event-core</module>
    <module>nexus-task-core</module>
    <module>nexus-file-core</module>
    <module>nexus-notification-core</module>
    <module>nexus-audit-core</module>
    <module>nexus-crypto-core</module>
    <module>nexus-p1-tenant</module>
    <module>nexus-p2-iam</module>
    <module>nexus-p3-studio</module>
    <module>nexus-p4-market</module>
    <module>nexus-p5-connect</module>
    <module>nexus-bootstrap</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- P0 freeze: Flyway 13.7.0 on PostgreSQL 15. Spring Boot 4.1.1 GA recorded 2026-08-20. -->
    <flyway.version>13.7.0</flyway.version>
    <isolation-kernel.version>0.1.0-m0</isolation-kernel.version>
    <quartz.version>2.5.2</quartz.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>isolation-kernel</artifactId>
        <version>${isolation-kernel.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-data-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
