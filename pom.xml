      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-file-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-notification-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-audit-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-crypto-core</artifactId>
        <version>${project.version}</version>
