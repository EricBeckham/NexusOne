      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-p1-tenant</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-p2-iam</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-p3-studio</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-p4-market</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>one.nexus</groupId>
        <artifactId>nexus-p5-connect</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
